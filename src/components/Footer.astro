---
import { nav, site } from "../data/site";
---

<footer class="footer">
  <div class="wrap cols">
    <p>{site.name}. {site.cadence}, from {site.city}.</p>
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 32px 0 40px;
    font-size: 14px;
    color: var(--muted);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    list-style: none;
    padding: 0;
  }
  a {
    color: var(--text-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
