---
// The issue list drawn as a transit line: each issue is a stop.
import type { Issue } from "../lib/issues";
import { formatDate } from "../lib/issues";

interface Props {
  issues: Issue[];
  latestNumber: number;
}
const { issues, latestNumber } = Astro.props;
---

<ol class="route">
  {
    issues.map((issue) => (
      <li>
        <span class:list={["stop", { "is-latest": issue.data.number === latestNumber }]} aria-hidden="true" />
        <a href={`/issues/${issue.id}/`}>
          <span class="num">No. {issue.data.number}</span>
          <span class="title">{issue.data.title}</span>
          <span class="dek">{issue.data.dek}</span>
          <time class="date" datetime={issue.data.date.toISOString().slice(0, 10)}>{formatDate(issue.data.date)}</time>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .route {
    list-style: none;
    padding: 0;
    position: relative;
  }
  .route::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 28px;
    bottom: 28px;
    width: 4px;
    margin-left: -1px;
    background: var(--accent);
    border-radius: 2px;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 24px;
  }
  li .stop {
    position: relative;
    z-index: 1;
    margin-top: 26px;
  }
  a {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    column-gap: 16px;
    row-gap: 4px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  li:last-child a {
    border-bottom: 0;
  }
  .num {
    grid-row: span 2;
    font-size: 14px;
    color: var(--muted);
    padding-top: 3px;
  }
  .title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.3;
    transition: color 150ms var(--ease);
  }
  .date {
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 4px;
    grid-column: 3;
    grid-row: 1;
  }
  .dek {
    grid-column: 2 / 4;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 44rem;
  }
  a:hover .title {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    li {
      gap: 16px;
    }
    a {
      grid-template-columns: 1fr;
    }
    .num {
      grid-row: auto;
      padding-top: 0;
    }
    .dek,
    .date {
      grid-column: auto;
      grid-row: auto;
    }
    .title {
      font-size: 20px;
    }
    li .stop {
      margin-top: 24px;
    }
  }
</style>
