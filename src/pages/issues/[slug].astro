---
import Base from "../../layouts/Base.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { getIssues, formatDate, readingMinutes, type Issue } from "../../lib/issues";

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue, i) => ({
    params: { slug: issue.id },
    props: { issue, newer: issues[i - 1], older: issues[i + 1], latestNumber: issues[0].data.number },
  }));
}

interface Props {
  issue: Issue;
  newer?: Issue;
  older?: Issue;
  latestNumber: number;
}
const { issue, newer, older, latestNumber } = Astro.props;
const { data } = issue;

// Put the sponsor note after the first section: before the second heading.
const html = issue.rendered?.html ?? "";
let before = html;
let after = "";
if (data.sponsor) {
  const cut = html.indexOf("<h2", html.indexOf("<h2") + 1);
  if (cut > 0) {
    before = html.slice(0, cut);
    after = html.slice(cut);
  }
}
---

<Base title={`No. ${data.number}: ${data.title}`} description={data.dek} type="article">
  <article class="wrap issue">
    <header>
      <p class="kicker">
        <span class:list={["stop", { "is-latest": data.number === latestNumber }]} aria-hidden="true"></span>
        No. {data.number}
      </p>
      <h1>{data.title}</h1>
      <p class="dek">{data.dek}</p>
      <p class="meta">
        <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>, {readingMinutes(issue)} min read
      </p>
    </header>

    <div class="prose">
      <Fragment set:html={before} />
      {
        data.sponsor && (
          <aside class="sponsor" aria-label="Sponsor">
            <p class="sponsor-label">This issue is supported by {data.sponsor.name}</p>
            <p>
              {data.sponsor.text}{" "}
              <a class="text-link" href={data.sponsor.href} rel="sponsored">
                Visit {data.sponsor.name}
              </a>
            </p>
          </aside>
        )
      }
      <Fragment set:html={after} />
    </div>

    <footer class="end">
      <SubscribeForm id="issue-email" />
      <nav class="pager" aria-label="More issues">
        {
          older ? (
            <a href={`/issues/${older.id}/`}>
              <span class="meta">Previous, No. {older.data.number}</span>
              <span class="t">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a class="next" href={`/issues/${newer.id}/`}>
              <span class="meta">Next, No. {newer.data.number}</span>
              <span class="t">{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>

<style>
  .issue {
    max-width: calc(680px + var(--gutter) * 2);
    padding-top: 72px;
    padding-bottom: 96px;
  }
  header {
    display: grid;
    gap: 16px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--text-2);
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .dek {
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .prose {
    padding-top: 40px;
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.7;
  }
  .prose :global(p) {
    margin: 0 0 24px;
  }
  .prose :global(h2) {
    font-family: var(--font-sans);
    font-size: 22px;
    line-height: 1.3;
    margin: 48px 0 16px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 4px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
  }
  .sponsor {
    margin: 40px 0 8px;
    padding: 20px 24px;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .sponsor p {
    margin: 0;
  }
  .sponsor-label {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 8px !important;
  }
  .end {
    display: grid;
    gap: 48px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pager a {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 150ms var(--ease);
  }
  .pager a:hover {
    background: var(--card);
  }
  .pager .next {
    text-align: right;
  }
  .t {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.35;
  }
  @media (max-width: 720px) {
    .issue {
      padding-top: 40px;
    }
    .prose {
      font-size: 18px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
