---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1>This stop isn't on the route</h1>
    <p>The page may have moved, or the address has a typo.</p>
    <a class="btn btn-primary" href="/issues/">See all issues</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-top: 120px;
    padding-bottom: 160px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 48px;
    line-height: 1.05;
  }
  p {
    font-size: 18px;
    color: var(--text-2);
  }
</style>
